{
  "name": "queeng-braids-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@queeng/web",
    "build": "npm run build --workspace=@queeng/web",
    "start": "npm run start --workspace=@queeng/web",
    "lint": "npm run lint --workspace=@queeng/web",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:features": "node scripts/e2e-features.mjs"
  }
}
