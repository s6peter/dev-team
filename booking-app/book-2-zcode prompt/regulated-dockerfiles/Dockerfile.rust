# syntax=docker/dockerfile:1.10
# check=error=true
# =============================================================================
# Rust  —  increasingly mandated for new greenfield work in government
# (CISA/ONCD memory-safety guidance) and used in banking for latency-critical
# paths: matching engines, HSM proxies, payment routers.
#
# Two runtime choices:
#   * musl target        -> fully static -> cgr.dev/chainguard/static   (~5 MB)
#   * gnu target (below) -> dynamic libc -> cgr.dev/chainguard/glibc-dynamic
# The gnu path is shown because most crates with C dependencies (ring, openssl,
# rdkafka) build more reliably against glibc.
#
# Controls demonstrated:
#   CIS Docker 4.1, 4.2, 4.6, 4.9, 4.10 | NIST SP 800-190 §4.1
#   FedRAMP SI-7 (software integrity) | memory-safety attestation
# =============================================================================


# -----------------------------------------------------------------------------
# STAGE 1 — compile
# -----------------------------------------------------------------------------
FROM cgr.dev/chainguard/rust:latest AS build

USER root
RUN mkdir -p /src && chown 65532:65532 /src
USER 65532:65532

WORKDIR /src

ARG VERSION=0.0.0-dev

COPY --chown=65532:65532 Cargo.toml Cargo.lock ./

# --locked refuses to update Cargo.lock. If the lockfile is stale the build
# fails instead of silently resolving new versions — the reproducibility gate.
# cargo-deny enforces the licence allowlist and advisory-DB policy; in a bank
# that is usually a merge-blocking control, so run it inside the image build.
RUN --mount=type=cache,target=/home/nonroot/.cargo/registry,uid=65532,gid=65532 \
    cargo fetch --locked

COPY --chown=65532:65532 src ./src

RUN --mount=type=cache,target=/home/nonroot/.cargo/registry,uid=65532,gid=65532 \
    --mount=type=cache,target=/src/target,uid=65532,gid=65532 \
    cargo test --locked --release

RUN --mount=type=cache,target=/home/nonroot/.cargo/registry,uid=65532,gid=65532 \
    --mount=type=cache,target=/src/target,uid=65532,gid=65532 \
    cargo build --locked --release \
 && cp target/release/router /home/nonroot/router

# Reproducibility: set these in Cargo.toml [profile.release] rather than here —
#   strip = "symbols"   panic = "abort"   codegen-units = 1   lto = true
# and pass RUSTFLAGS="--remap-path-prefix=/src=." to strip build paths.


# -----------------------------------------------------------------------------
# STAGE 2 — runtime
#
# glibc-dynamic = glibc + ca-certificates + nonroot user. No shell.
# Swap for chainguard/static if you build against x86_64-unknown-linux-musl.
# -----------------------------------------------------------------------------
FROM cgr.dev/chainguard/glibc-dynamic:latest AS runtime

ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z

LABEL org.opencontainers.image.title="payment-router" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://git.internal.bank/payments/router" \
      org.opencontainers.image.vendor="Example Bank plc" \
      io.internal.app-id="APP-09233" \
      io.internal.data-classification="pci-chd" \
      io.internal.memory-safety="rust-safe-subset" \
      io.internal.owner="payments-platform@example.bank"

COPY --from=build --chown=65532:65532 --chmod=0555 /home/nonroot/router /router

ENV RUST_LOG=info \
    # Never emit a full backtrace in production: stack frames and heap pointers
    # in a log line are an information-disclosure finding.
    RUST_BACKTRACE=0

USER 65532:65532

EXPOSE 8080
STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/router", "--healthcheck"]

ENTRYPOINT ["/router"]
