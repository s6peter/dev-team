# syntax=docker/dockerfile:1.10
# check=error=true
# =============================================================================
# Python 3 / FastAPI  —  healthcare analytics, HL7/FHIR interface engines,
# actuarial and risk models, AML/fraud scoring, government data services.
#
# Python is the hardest ecosystem to make audit-clean, because pip will happily
# resolve a different dependency graph on every build. The two controls that
# fix that are hash-pinning and a lockfile — both shown below.
#
# Controls demonstrated:
#   CIS Docker 4.1, 4.2, 4.3, 4.9, 4.10 | NIST SP 800-190 §4.1
#   HIPAA 164.312(a)(1), 164.312(e)(1) | PCI-DSS 6.3.2 (supply chain)
#
# Build:
#   pip-compile --generate-hashes -o requirements.txt requirements.in
#   docker buildx build --sbom=true --provenance=mode=max -t fhir-gw:2.3.0 .
# =============================================================================


# -----------------------------------------------------------------------------
# STAGE 1 — build the virtualenv
#
# The *-dev variant carries apk, a shell, and the toolchain needed to compile
# wheels for packages with C extensions (pydantic-core, cryptography, numpy).
# None of that survives into stage 2.
# -----------------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest-dev AS build

USER root
RUN mkdir -p /app && chown 65532:65532 /app
USER 65532:65532

WORKDIR /app

# A venv is the cleanest unit to hand to the runtime stage: one directory,
# no site-packages archaeology, no root-owned files.
RUN python -m venv /app/venv
ENV PATH="/app/venv/bin:${PATH}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_COMPILE=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --chown=65532:65532 requirements.txt ./

# --require-hashes is the control that matters. It refuses to install anything
# whose SHA-256 is not listed, which defeats dependency-confusion and
# compromised-mirror attacks and makes the build byte-reproducible.
# --only-binary=:all: additionally forbids running arbitrary setup.py code.
RUN --mount=type=cache,target=/home/nonroot/.cache/pip,uid=65532,gid=65532 \
    --mount=type=secret,id=pip_index,target=/tmp/pip.conf,uid=65532,required=false \
    PIP_CONFIG_FILE=/tmp/pip.conf \
    pip install --require-hashes --only-binary=:all: -r requirements.txt

COPY --chown=65532:65532 app ./app


# -----------------------------------------------------------------------------
# STAGE 2 — runtime
#
# chainguard/python (no -dev): interpreter only. No apk, no shell, no pip.
# "No pip in production" is itself a control — nothing can install at runtime.
#
# The two stages MUST share a Python minor version or the venv's compiled
# extensions will not import. Both use :latest here, so they track together;
# if you pin one by digest, pin the other from the same release.
# -----------------------------------------------------------------------------
FROM cgr.dev/chainguard/python:latest AS runtime

ARG VERSION=0.0.0-dev
ARG VCS_REF=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z

LABEL org.opencontainers.image.title="fhir-gateway" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://git.internal.example/interop/fhir-gateway" \
      org.opencontainers.image.vendor="Example Health System" \
      io.internal.app-id="APP-77120" \
      io.internal.data-classification="phi" \
      io.internal.owner="interoperability@example.health"

WORKDIR /app

COPY --from=build --chown=65532:65532 /app/venv /app/venv
COPY --from=build --chown=65532:65532 --chmod=0444 /app/app /app/app

ENV PATH="/app/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    # Do not let a crash write a core dump containing PHI to the filesystem.
    PYTHONFAULTHANDLER=0

USER 65532:65532

EXPOSE 8080
STOPSIGNAL SIGTERM

# Python is the one runtime here that CAN satisfy CIS 4.6 natively: the
# interpreter is present, so no extra binary is needed. Kubernetes still
# ignores this — keep an equivalent readinessProbe in the manifest.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["/app/venv/bin/python", "-c", \
       "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2).status==200 else 1)"]

# Exec form, no shell wrapper: uvicorn is PID 1 and receives SIGTERM directly,
# so it finishes in-flight requests before the pod terminates.
ENTRYPOINT ["/app/venv/bin/python", "-m", "uvicorn", "app.main:app", \
            "--host", "0.0.0.0", "--port", "8080", \
            "--no-server-header", "--proxy-headers", "--forwarded-allow-ips", "*"]
